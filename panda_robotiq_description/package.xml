<?xml version="1.0"?>
<package format="2">
  <name>panda_robotiq_description</name>
  <version>0.0.1</version>
  <description>URDF of a Franka Emika Panda arm with a Robotiq 2F-85 gripper mounted at the flange</description>

  <maintainer email="hyesine1107@gmail.com">KIM-HYEDO</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>franka_description</exec_depend>
  <exec_depend>robotiq_2f_85_gripper_visualization</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz</exec_depend>
  <!-- set_ee_frame.py -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
