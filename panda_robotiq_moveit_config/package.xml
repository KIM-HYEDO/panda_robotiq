<?xml version="1.0"?>
<package format="2">
  <name>panda_robotiq_moveit_config</name>
  <version>0.0.1</version>
  <description>MoveIt configuration for the Franka Emika Panda with a Robotiq 2F-85 gripper</description>

  <maintainer email="hyesine1107@gmail.com">KIM-HYEDO</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>python3-setuptools</build_depend>

  <!-- gripper.py -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>moveit_commander</exec_depend>

  <exec_depend>panda_robotiq_description</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_fake_controller_manager</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- real robot: bringup.launch, real_robot.launch -->
  <exec_depend>franka_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robotiq_2f_gripper_control</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <!-- Gripper panel in moveit.rviz -->
  <exec_depend>robotiq_2f_gripper_rviz</exec_depend>
</package>
